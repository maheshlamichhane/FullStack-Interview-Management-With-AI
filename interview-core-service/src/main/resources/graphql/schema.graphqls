scalar Long
scalar DateTime

type Query {

    getAllDepartments : [DepartmentResponse]!
    getActiveDepartments : [DepartmentResponse]!
    getDepartmentById(id: ID!) : DepartmentResponse!

    findAllJob: [Job]!
    findAllJobByDepartmentId(id: ID!) : [Job]!

    getAllNestedDepartments: [DepartmentNestedResponse]!

}


type Mutation{
    createDepartment(department: DepartmentRequest!) : DepartmentResponse
    updateDepartment(id: Long!,department:DepartmentRequest!) : DepartmentResponse
    deleteDepartment(id: Long!) : DeleteResponse
}

type Job{
    id: ID!,
    name: String
    departmentId: Long
}

type DeleteResponse{
    id: ID!,
    status: Status
}

enum Status{
    SUCCESS
    FAILURE
}

input DepartmentRequest{
    name: String,
    code: String,
    description: String,
    managerId: Long,
    active: Boolean,
    budgetCode: String,
    costCenter: String,
    createdAt: DateTime,
    updatedAt: DateTime
}

type DepartmentResponse{
    id: ID!,
    name: String,
    code: String,
    description: String,
    managerId: Long,
    isActive: Boolean,
    budgetCode: String,
    costCenter: String,
    createdAt: DateTime,
    updatedAt: DateTime,
    jobPositionCount: Int,
    teamSize: Int
}

type DepartmentNestedResponse{
    id: ID!,
    name: String,
    code: String,
    description: String,
    managerId: Long,
    isActive: Boolean,
    budgetCode: String,
    costCenter: String,
    createdAt: DateTime,
    updatedAt: DateTime,
    jobPositionCount: Int,
    teamSize: Int,
    jobs: [Job]
}