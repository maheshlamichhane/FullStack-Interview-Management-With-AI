scalar Long
scalar DateTime

type Query {
    getAllDepartments : [DepartmentResponse]!
    getActiveDepartments : [DepartmentResponse]!
    getDepartmentById(id: ID!) : DepartmentResponse!
}

type Mutation{
    createDepartment(department: DepartmentRequest) : DepartmentResponse
    updateDepartment(id: Long!,department:DepartmentRequest!) : DepartmentResponse
    deleteDepartment(id: Long!) : DeleteResponse
}

type DeleteResponse{
    id: ID!,
    status: Status
}

enum Status{
    SUCCESS
    FAILURE
}

input DepartmentRequest{
    name: String,
    code: String,
    description: String,
    managerId: Long,
    isActive: Boolean,
    budgetCode: String,
    costCenter: String,
    createdAt: DateTime,
    updatedAt: DateTime
}

type DepartmentResponse{
    id: ID!,
    name: String,
    code: String,
    description: String,
    managerId: Long,
    isActive: Boolean,
    budgetCode: String,
    costCenter: String,
    createdAt: DateTime,
    updatedAt: DateTime,
    jobPositionCount: Int,
    teamSize: Int
}